# LeadStreamAI Backend Environment Variables
# Copy to backend/app/.env and customize

# ============================================
# REQUIRED - No defaults, must be set
# ============================================

# Database (PostgreSQL - Neon or local)
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# Admin user (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=  # REQUIRED - Set a strong password, no default

# Google OAuth (required for Gmail integration)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback

# ============================================
# API Keys (at least one LLM required)
# ============================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Groq (Llama)
GROQ_API_KEY=

# ============================================
# Email & Communication
# ============================================

# Resend (transactional emails)
RESEND_API_KEY=

# SMTP (fallback)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Sender email for system emails
SENDER_EMAIL=your-email@gmail.com

# ============================================
# External Services
# ============================================

# RocketReach (people search)
ROCKETREACH_API_KEY=

# Redis (caching, rate limiting - required for production)
REDIS_URL=redis://default:password@host:port
# Or for Render Redis with TLS:
# REDIS_TLS_URL=rediss://default:password@host:port

# Gmail Pub/Sub push notifications
GMAIL_WATCH_TOPIC=projects/your-project/topics/gmail-push

# RAG System (external service)
# RAG_URL=https://rag-sys-gz59.onrender.com

# ============================================
# URLs
# ============================================

# Backend public URL (for webhooks, email links)
BACKEND_URL=https://your-backend.onrender.com

# Frontend public URL (for OAuth redirects, unsubscribe links)
FRONTEND_URL=https://your-frontend.onrender.com

# Vite API base (frontend env)
VITE_API_BASE_URL=https://your-backend.onrender.com

# ============================================
# Company Data Sources
# ============================================

# Family Offices Google Sheet
FAMILY_OFFICES_PATH="https://docs.google.com/spreadsheets/d/your-sheet-id/edit?gid=0"

# Company Database Google Sheet
COMPANY_DATABASE_PATH="https://docs.google.com/spreadsheets/d/your-sheet-id/edit?gid=212887034"

# ============================================
# Optional / Debug
# ============================================

# Debug mode (enables verbose logging, disables SSL verify for local dev)
DEBUG=false

# Render external URL (auto-set on Render)
RENDER_EXTERNAL_URL=